rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  function isSignedIn() { return request.auth != null; }
  function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
  // Admin esperado vía Custom Claims: request.auth.token.role == 'admin' o flag booleano 'admin'
  function isAdmin() { return isSignedIn() && (request.auth.token.role == 'admin' || request.auth.token.admin == true); }
    // Lectura pública autenticada de establecimientos (solo lectura)
    match /establecimientos/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Perfil del usuario: dueño o admin pueden leer.
    // Owner puede crear/actualizar su doc, pero NO puede cambiar 'role'.
    // 'role' sólo editable por admin. En create, si viene, debe ser 'user' o null.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && (
        !('role' in request.resource.data) || request.resource.data.role == 'user'
      );
      allow update: if (
        // Dueño: puede actualizar su perfil mientras no cambie 'role'
        (isOwner(uid) && request.resource.data.role == resource.data.role)
        ||
        // Admin: puede actualizar cualquier campo, incluido 'role'
        isAdmin()
      );
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Subcolecciones privadas del usuario: lectura/escritura solo por el dueño autenticado
    match /users/{uid}/datosBasicos/{docId} {
      allow read, write, update, delete: if isOwner(uid) || isAdmin();
    }
    match /users/{uid}/datosRedes/{docId} {
      allow read, write, update, delete: if isOwner(uid) || isAdmin();
    }
    match /users/{uid}/datosActas/{docId} {
      allow read, write, update, delete: if isOwner(uid) || isAdmin();
    }
    // Notas personales (usadas por index.html/app.js)
    match /users/{uid}/notas/{docId} {
      allow read, write, update, delete: if isOwner(uid) || isAdmin();
    }

    // Colección global compartida: lectura/creación/edición para cualquier usuario autenticado;
    // borrado solo por el dueño (ownerUid)
    match /datosBasicos/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // se mantiene política abierta para edición colaborativa
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Colección global de documentos de Redes (si se usa): mismas reglas que datosBasicos
    match /datosRedes/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }
  }
}
